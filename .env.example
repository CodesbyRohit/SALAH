# Salah environment
# Copy to .env and fill in. Application runs WITHOUT these keys
# (analytics-only degraded mode) — keys unlock LLM/voice/memory.

# Google Gemini (explanations + Cognee backing LLM)
GEMINI_API_KEY=
# Optional overrides for the Phase 3 LLM safety layer
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TIMEOUT=15

# Sarvam AI (voice STT/TTS)
SARVAM_API_KEY=

# Optional: cognee config
COGNEE_LLM_API_KEY=
